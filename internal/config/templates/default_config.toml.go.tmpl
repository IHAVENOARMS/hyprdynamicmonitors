[general]
# Load it from hyprland.lua with: require("hyprdynamicmonitors")
destination = "$HOME/.config/hypr/hyprdynamicmonitors.lua"

[power_events]

{{- $path := (cond .ObjectPath .ObjectPath "/org/freedesktop/UPower/devices/line_power_ACAD") }}

[power_events.dbus_query_object]
path = "{{ $path }}"

[[power_events.dbus_signal_match_rules]]
object_path = "{{ $path }}"
