{{- $laptop := index .MonitorsByTag "laptop" -}}
-- Generated with power state: {{.PowerState}}

{{ if isOnBattery }}
-- disable animations, reduce refresh rate, enable vrr
hl.monitor({ output = "{{ $laptop.Name }}", mode = "2880x1920@60", position = "0x0", scale = 2, vrr = true })
hl.config({ animations = { enabled = false } })
{{- else}}
-- enable animations, max refresh rate, disable vrr
hl.monitor({ output = "{{ $laptop.Name }}", mode = "2880x1920@120", position = "0x0", scale = 2, vrr = false })
hl.config({ animations = { enabled = true } })
{{- end}}
