-- Laptop template using global template variables
{{- range .Monitors }}
{{- if eq .Tag "laptop" }}
hl.monitor({
	output = "{{ .Name }}",
	mode = "1920x1080@{{ $.refresh_rate_ac }}",
	position = "0x0",
	scale = {{ $.default_scaling }},
	vrr = {{ $.default_vrr }},
})
{{- end }}
{{- end }}

-- Using brightness variable
-- Note: with live_apply this command runs every time the profile is applied
hl.exec_cmd("brightnessctl set {{ .brightness_high }}")
