-- Example: hl.monitor({ output = "DP-1", disabled = true })
-- Note: monitor settings disabled = true configurations
hl.monitor({ output = "eDP-1", mode = "2880x1920@120", position = "0x0", scale = 2, vrr = true })
-- This comment should be kept: normal comment
hl.monitor({ output = "DP-2", disabled = false })
	-- Another indented disabled = true comment that matches
hl.workspace_rule({ workspace = "1", monitor = "eDP-1", default = true })
